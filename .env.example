# Meta app settings
META_APP_SECRET=replace_with_meta_app_secret
META_VERIFY_TOKEN=replace_with_any_random_verify_token
META_API_VERSION=v25.0
APP_BASE_PATH=/instagram-bot

# Leave enabled in production. Disable only for unsigned local curl tests.
VERIFY_META_SIGNATURES=true

# One Meta app can receive webhooks for multiple Instagram Professional accounts.
# Each entry has its own IG user ID, token, keyword replies, moderation, public reply, and DM rules.
INSTAGRAM_ACCOUNTS_JSON=[{"id":"brand-a","displayName":"Brand A","metaIgUserId":"replace_with_brand_a_ig_user_id","metaAccessToken":"replace_with_brand_a_access_token","keywordResponses":{"GUIDE":"Hey! Here's the guide: https://example.com/a-guide","BOT":"Here's the chatbot: https://example.com/a-bot"},"publicRepliesEnabled":false,"publicReplyRules":[{"id":"high-intent-brand-fit","enabled":true,"templates":["Appreciate this. That is exactly the kind of question worth asking.","Yes - this is the direction I think more people should be looking at.","Strong point. This is the part most people skip."],"philosophyKeywords":["clarity","discipline","systems","growth","business","brand","automation","leverage"],"excludeKeywords":["cheap","scam","fake","dm me","promo"],"minLength":25,"maxLength":280,"requirePositiveSignal":true,"minScore":3,"probability":0.35,"maxRepliesPerMediaPerDay":8,"maxRepliesGlobalPerDay":35}],"moderationEnabled":true,"moderationRules":[{"id":"hate-harassment-threats","enabled":true,"action":"delete","reason":"Hateful, harassing, or threatening language","keywords":["kill yourself","kys","hate you","go die"]},{"id":"business-risk-spam","enabled":true,"action":"hide","reason":"Spam or bad-for-business solicitation","keywords":["buy followers","crypto giveaway","forex profit","dm for promo","telegram me"]}],"dmAutoResponderEnabled":false,"dmAutoResponseRules":[{"id":"pricing","enabled":true,"anyKeywords":["price","pricing","cost","how much"],"excludeKeywords":["refund","angry","scam"],"maxRepliesPerSenderPerDay":2,"cooldownSeconds":3600,"templates":["I can help with that. The best starting point is here: https://example.com/a-pricing","Good question. Pricing depends on the setup, but this page gives the clean overview: https://example.com/a-pricing"]}]},{"id":"brand-b","displayName":"Brand B","metaIgUserId":"replace_with_brand_b_ig_user_id","metaAccessToken":"replace_with_brand_b_access_token","keywordResponses":{"GUIDE":"Hey! Here's the guide: https://example.com/b-guide","GLOWUP":"Here's the glow-up page: https://example.com/b-glowup"},"publicRepliesEnabled":false,"publicReplyRules":[],"moderationEnabled":true,"moderationRules":[{"id":"spam","enabled":true,"action":"hide","reason":"Spam or solicitation","keywords":["buy followers","promo","telegram me","whatsapp me"]}],"dmAutoResponderEnabled":false,"dmAutoResponseRules":[]}]

# File-backed persistence. Keys are scoped by account id.
DEDUPE_STORE_PATH=data/processed-comments.json
EVENT_LOG_PATH=data/events.jsonl
