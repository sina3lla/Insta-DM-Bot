PORT=3000
NODE_ENV=development

# Meta app settings
META_APP_SECRET=replace_with_meta_app_secret
META_VERIFY_TOKEN=replace_with_any_random_verify_token
META_ACCESS_TOKEN=replace_with_instagram_user_or_page_access_token
META_IG_USER_ID=replace_with_your_instagram_professional_account_id
META_API_VERSION=v25.0

# Leave enabled in production. Disable only for local unsigned curl tests.
VERIFY_META_SIGNATURES=true

# JSON object mapping comment keywords to private reply text.
# Matching is case-insensitive and token-based: "GUIDE!" matches GUIDE, "my guide please" matches GUIDE.
KEYWORD_RESPONSES_JSON={"GUIDE":"Hey! Here's the guide: https://example.com/guide","BOT":"Here's the chatbot: https://example.com/bot","GLOWUP":"Here's the glow-up page: https://example.com/glowup"}

# Public comment replies are off by default. Turn on after tuning the rules.
PUBLIC_REPLIES_ENABLED=false
PUBLIC_REPLY_RULES_JSON=[{"id":"high-intent-brand-fit","enabled":true,"templates":["Appreciate this. That is exactly the kind of question worth asking.","Yes - this is the direction I think more people should be looking at.","Strong point. This is the part most people skip."],"philosophyKeywords":["clarity","discipline","systems","growth","business","brand","automation","leverage"],"excludeKeywords":["cheap","scam","fake","dm me","promo"],"minLength":25,"maxLength":280,"requirePositiveSignal":true,"minScore":3,"probability":0.35,"maxRepliesPerMediaPerDay":8,"maxRepliesGlobalPerDay":35}]

# Moderation runs before private DMs or public replies. Use delete only for categories you are confident about.
MODERATION_ENABLED=true
MODERATION_RULES_JSON=[{"id":"hate-harassment-threats","enabled":true,"action":"delete","reason":"Hateful, harassing, or threatening language","keywords":["kill yourself","kys","hate you","nazi","terrorist","stupid bitch","worthless","go die"]},{"id":"business-risk-spam","enabled":true,"action":"hide","reason":"Spam or bad-for-business solicitation","keywords":["buy followers","crypto giveaway","forex profit","dm for promo","send pics","onlyfans","telegram me","whatsapp me"]}]

# Incoming DM autoresponder is off by default. Requires Instagram messaging permissions and message webhook subscriptions.
DM_AUTORESPONDER_ENABLED=false
DM_AUTORESPONSES_JSON=[{"id":"pricing","enabled":true,"anyKeywords":["price","pricing","cost","how much"],"excludeKeywords":["refund","angry","scam"],"maxRepliesPerSenderPerDay":2,"cooldownSeconds":3600,"templates":["I can help with that. The best starting point is here: https://example.com/pricing","Good question. Pricing depends on the setup, but this page gives the clean overview: https://example.com/pricing","Here is the pricing overview: https://example.com/pricing - send me one detail about what you need and I can point you better."]},{"id":"guide","enabled":true,"anyKeywords":["guide","resource","checklist"],"maxRepliesPerSenderPerDay":2,"cooldownSeconds":1800,"templates":["Here is the guide: https://example.com/guide","Got you - this is the resource I would start with: https://example.com/guide","Sending the guide here: https://example.com/guide"]}]

# File-backed persistence for a single-instance deployment.
DEDUPE_STORE_PATH=data/processed-comments.json
EVENT_LOG_PATH=data/events.jsonl
